          log "Not playing anything :(. Music suggest : Bakenohana(Nightcord at 25.)"
        fi
      }
    else
      err "Command '${UNDERLINE}playerctl$RESET${RED}' not found! No music information :( "
    fi
  else
    err "Cannot get music information from ${UNDERLINE}Windows$RESET${RED} :(."
  fi

  LoadAVG() {
    if [ -f /proc/loadavg ]; then
      IFS= read -r Load </proc/loadavg
      info "Load AVG" "$Load"
      log "Load AVG : $Load"
    else
      err "${UNDERLINE}/proc/loadavg$RESET$RED not found! Maybe there's no load."
    fi
  }
  ;;
*)
  err "idk what OS is $UNDERLINE$BOLD$OS"
  ;;
esac

