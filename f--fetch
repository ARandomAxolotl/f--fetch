      info "OS" "${YELLOW}Windows"
    }
  fi

  if hascmd awk; then
    Memory() {
      MemTotal="$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo)"
      MemMiB=$((MemTotal / 1024))
      printf '%-10s : %s ' "Memory" "$GREEN${MemMiB}MiB"
      log "Memory : ${MemMiB}MiB"
      if [ -f /proc/swaps ]; then
        swaps=$(awk 'NR > 1 { printf "%s%s : %sMiB", (NR > 2 ? ", " : "("), $1, $3/1024 } END { print ")" }' /proc/swaps)
        log "Got swap : $swaps"
        printf '%s' "$swaps"
      fi
      printf '%s \n' "$RESET"
    }

    CPU() {
      CPU="$(awk -F: '/^model name/ {gsub(/^[ \t]+/, "", $2); print $2; exit}' /proc/cpuinfo)"

      if [ "x$CPU" = "x" ]; then
        CPU="$(awk -F: '/^system type/ {gsub(/^[ \t]+/, "", $2); print $2; exit}' /proc/cpuinfo)"
      fi

      if [ "x$CPU" = "x" ]; then
        CPU="$BOLD${RED}idk"
        err 'No idea what the hell is the cpu.'
      fi
      
      log "CPU : $CPU"

      info "CPU" "$CPU"
    }

    Uptime() {
      Uptime="$(awk '{printf "%d days, %02d:%02d:%02d\n", $1/86400, $1/3600%24, $1/60%60, $1%60}' /proc/uptime)"
      log "Uptime : $Uptime"
      info "Uptime" "$Uptime"
    }

    if [ "$OS" = "Linux" ]; then
      Init() {
        init="$(awk '/^Name:/ {print $2; exit}' /proc/1/status)"
        if [ "x$init" = "x" ]; then
          init="$BOLD${RED}lol no"
          err "Init so ${BOLD}${UNDERLINE}UNTUFF${RESET}${RED} it hides itself."
        fi
        
        log "Init : $init"

        info "Init" "$init"
