if command >/dev/null 2>&1; then
  hascmd() {
    command -v "$1" >/dev/null 2>&1
  }
else
  if type >/dev/null 2>&1; then
    err "Command '${UNDERLINE}command$RESET${RED}' not found! Falling back to 'type'."
    hascmd() {
      type "$1" >/dev/null 2>&1
    }
  else
    hascmd(){
      old_ifs=$IFS
      IFS=:
      for dir in $PATH; do
        [ -x "${dir:-.}/$1" ] && {
          IFS=$old_ifs
          return 0
        }
      done
      IFS=$old_ifs
      return 1
    }
  fi
fi

# Use this when the entire shit is done
print_fetch() {
  log "printing..."
  info=$1

  exec 3<<EOF
$info
EOF

  while :; do
    logo_line=
    info_line=

    if IFS= read -r logo_line <&0; then
      logo_done=0
    else
      logo_done=1
    fi

    if IFS= read -r info_line <&3; then
      info_done=0
    else
      info_done=1
    fi

    [ "$logo_done" = 1 ] && [ "$info_done" = 1 ] && break

    printf '%-29s %s\n' "$logo_line" "$info_line"

    unset logo_done info_done
  done <<EOF
$logo
EOF

  exec 3<&-
}

