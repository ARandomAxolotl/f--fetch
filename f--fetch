Pwd() {
  if [ "x$HOME" != "x" ] && [ "x$PWD" != "x" ]; then
    case "$PWD" in
      "$HOME")
        pwd='~'
        ;;
      "$HOME"/*)
        pwd="~/${PWD#"$HOME"/}"
        ;;
      *)
        pwd="$PWD"
        ;;
    esac
    info "PWD" "$pwd"
  fi
}

