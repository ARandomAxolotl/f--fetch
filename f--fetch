if hascmd wc; then
  Packages() {
    pkg=0
    printf '%-10s : %s' "Packages" "$GREEN"

    if hascmd dpkg-query; then
      if [ $pkg = 0 ]; then
        pkg=1
      else
        printf ', '
      fi
      log "Waiting for dpkg-query..."
      printf 'dpkg (%s)' "$(dpkg-query -W | wc -l)"
    fi

    if hascmd pacman; then
      if [ $pkg = 0 ]; then
        pkg=1
      else
        printf ', '
      fi
      log "Waiting for pacman..."
      AURTotal=$(pacman -Qm | wc -l)
      PacmanTotal=$(pacman -Q | wc -l)
      printf 'pacman(Total : %s, System : %s, AUR : %s)' "$PacmanTotal" "$(($PacmanTotal - $AURTotal))" "$AURTotal"
    fi

    if hascmd dnf5; then
      if [ $pkg = 0 ]; then
        pkg=1
      else
        printf ', '
      fi
      log "Waiting for dnf5..."
      printf 'dnf5(%s)' "$(dnf5 list --installed | wc -l)"
    fi

    if hascmd dnf; then
      if [ $pkg = 0 ]; then
        pkg=1
      else
        printf ', '
      fi
      log "Waiting for dnf..."
      printf 'dnf(%s)' "$(dnf list --installed | wc -l)"
    fi

    # This check is super tuff as i wrote this on the iphone 8 plus
    if hascmd apk; then
      if [ $pkg = 0 ]; then
        pkg=1
      else
        printf ', '
      fi
      log "Waiting for apk..."
      printf 'apk(%s)' "$(apk list -I | wc -l)"
    fi

    if hascmd flatpak; then
      if [ $pkg = 0 ]; then
        pkg=1
      else
        printf ', '
      fi
      log "Waiting for flatpak..."
      flatpakapps=$(flatpak list --app | wc -l)
      flatpaktotal=$(flatpak list | wc -l)
      printf 'flatpak(Total : %s, Apps : %s, Runtime : %s)' "$flatpaktotal" "$flatpakapps" "$(($flatpaktotal - $flatpakapps))"
    fi

    if hascmd winget; then
      if [ $pkg = 0 ]; then
        pkg=1
      else
        printf ', '
      fi
      log "Waiting for winget..."
      printf 'winget(%s)' "$(($(winget list | wc -l) - 2))"
    fi

    if hascmd choco; then
      if [ $pkg = 0 ]; then
        pkg=1
      else
        printf ', '
      fi
      log "Waiting for chocolatey..."
      printf 'chocolatey(%s)' "$(($(choco list | wc -l) - 2))"
    fi

    if hascmd scoop; then
      if [ "$pkg" = 0 ]; then
        pkg=1
      else
        printf ', '
      fi
      log "Waiting for scoop..."
      printf 'scoop(%s)' "$(($(scoop list | wc -l) - 5))"
    fi

    if hascmd brew; then
      if [ "$pkg" = 0 ]; then
        pkg=1
      else
        printf ', '
      fi
      log "Waiting for homebrew..."
      printf 'homebrew(%s)' "$(brew list --formula | wc -l)"
    fi

    if hascmd snap; then
      if [ "$pkg" = 0 ]; then
        pkg=1
      else
        printf ', '
      fi
      log "Waiting snap..."
      printf 'snap(%s)' "$(($(snap list 2>/dev/null | wc -l) - 1))"
    fi

    # language-specific packages manager

    if hascmd pipx; then
      if [ "$pkg" = 0 ]; then
        pkg=1
      else
        printf ', '
      fi
      log "Waiting for pipx..."
      printf 'pipx(%s)' "$(pipx list --short | wc -l)"
    fi

    if hascmd pip; then
      if [ "$pkg" = 0 ]; then
        pkg=1
      else
        printf ', '
      fi
      log "Waiting for pip..."
      printf 'pip('
      PipVenvPkg=0
      if ! [ "x$VIRTUAL_ENV" = "x" ]; then
        PipVenvPkg=$(pip list --format=freeze -l | wc -l)
        printf 'venv : %s, ' "$PipVenvPkg"
      fi
      PipPkg="$(($(pip list --format=freeze | wc -l) - $PipVenvPkg))"
      printf 'user : %s)' "$PipPkg"
    fi

    if [ $pkg = 0 ]; then
      err "No known ${UNDERLINE}packages manager$RESET${RED} found!"
      printf '%s' "$BOLD${RED}no"
    fi

    printf '%s\n' "$RESET"

    log "Packages manager checking done!"
  }
else
  err "Command '${UNDERLINE}wc$RESET${RED}' not found!"
fi

