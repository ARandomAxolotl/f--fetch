          printf '%-10s : %s(%s) : %s\n' \
            "Music" "$GREEN$title" "$(playerctl metadata xesam:artist)" \
            "$(playerctl metadata mpris:length | awk '{ s = int($1 / 1000000); printf "%d:%02d\n", int(s / 60), s % 60 }')$RESET"
